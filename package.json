{
  "name": "yesid.static-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24 <25"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js dev",
    "prepare": "node node_modules/@sveltejs/kit/svelte-kit.js sync",
    "check": "node node_modules/@sveltejs/kit/svelte-kit.js sync && node node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json",
    "test": "bun run build && bun test tests",
    "build": "node node_modules/vite/bin/vite.js build",
    "cms:config": "bun scripts/generate-cms-config.ts",
    "content:format": "bun scripts/format-content.ts"
  },
  "dependencies": {
    "@yesid/content-contract": "https://github.com/mgkdante/yesid.content-contract/releases/download/v0.3.0/yesid-content-contract-0.3.0.tgz",
    "marked": "18.1.3",
    "sanitize-html": "2.18.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.0.0",
    "@types/bun": "1.4.4",
    "@types/sanitize-html": "2.16.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  }
}
